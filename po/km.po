#: src/bookworm.vala:109
msgid "Display version number"
msgstr "បង្ហាញលេខកំណែ"

#: src/bookworm.vala:110
msgid "Run Bookworm in debug mode"
msgstr "ដំណើរការ​ Bookworm ជាមួយមុខងារ Debug"

#: src/bookworm.vala:111
msgid "Run Bookworm in info mode"
msgstr "ដំណើរការ​ Bookworm ក្នុងមុខងារ បង្ហាញពណ៍មាន"

#: src/bookworm.vala:112
msgid "Automatically add new books from watched folders"
msgstr "បន្ថែមសៀវភៅថ្មីដោយស្វ័យប្រវត្តិពី folder ដែលបានកំណត់"

#: src/utils.vala:552 src/utils.vala:639
msgid "Cancel"
msgstr "បោះបង់"

#: src/utils.vala:554 src/utils.vala:640
msgid "Open"
msgstr "បើក"

#: src/utils.vala:556
msgid "Save"
msgstr "រក្សាទុក"

#: src/constants.vala.in:29
msgid "An eBook Reader"
msgstr "អ្នកអាន សៀវភៅអេឡិចត្រូនិច"

#: src/constants.vala.in:31
msgid "Weblate Translators"
msgstr "វេបសាយ បកប្រែ"

#: src/constants.vala.in:37
msgid "Website | Translation | Bug Tracker"
msgstr "វេបសាយ| បកប្រែ| តាមដានកំហុសបច្ចេកទេស"

#: src/constants.vala.in:39
msgid "Not Available"
msgstr "មិនទាន់មាន"

#: src/constants.vala.in:40 data/com.github.babluboy.bookworm.desktop.in:4
msgid "eBook Reader"
msgstr "អ្នកអានសៀវភៅអេឡិចត្រូនិច"

#: src/constants.vala.in:41
msgid "Search this book…"
msgstr "ស្វែងរកសៀវភៅនេះ…"

#: src/constants.vala.in:42
msgid "Search by Title, Author and Tags"
msgstr "ស្វែងរក តាមចំណងជើង, និពន្ធ និងស្លាកសញ្ញា"

#: src/constants.vala.in:43
msgid "Looks like Bookworm has no books"
msgstr "មើលទៅដូចជា Bookworm មិនទាន់មានសៀវភៅនៅឡើយទេ"

#: src/constants.vala.in:44
msgid "Build your library by adding eBooks"
msgstr "បង្កើតបណ្ណាល័យដោយបន្ថែមសៀវភៅអេឡិចត្រូនិច"

#: src/constants.vala.in:45
msgid "Select an eBook to read"
msgstr "ជ្រើសរើសសៀវភៅអេឡិចត្រូនិចដើម្បីអាន"

#: src/constants.vala.in:46
msgid ""
"Problem in extracting contents of book. Ensure there is a valid eBook file "
"here: "
msgstr ""
"មានបញ្ហាក្នុងការទាញយកមាតិកាសៀវភៅ។ សូមប្រាកដថាមានឯកសារសៀវភៅអេឡិចត្រូនិចត្រឹមត្រូវនៅទីនេះ:។ "

#: src/constants.vala.in:47
msgid "Invalid media type detected. Check format for this eBook: "
msgstr ""
"រកឃើញប្រភេទមេឌៀមិន ត្រឹមត្រូវ។ សូមពិនិត្យមើលទម្រង់ Format​ សម្រាប់សៀវភៅអេឡិចត្រូនិចនេះ៖។ "

#: src/constants.vala.in:48
msgid "Invalid content found. Ensure there is a valid eBook file here: "
msgstr ""
"រកឃើញមាតិកាមិនត្រឹមត្រូវ។ សូមប្រាកដថាមានឯកសារសៀវភៅអេឡិចត្រូនិចត្រឹមត្រូវនៅទីនេះ៖។ "

#: src/constants.vala.in:49
msgid "eBook could not be parsed. Ensure there is a valid eBook file here: "
msgstr ""
"មិនអាចវិភាគ សៀវភៅអេឡិចត្រូនិចបានទេ។ សូមប្រាកដថាមានឯកសារសៀវភៅអេឡិចត្រូនិចត្រឹមត្រូវនៅទីនេះ៖ "

#: src/constants.vala.in:50
msgid "Bookworm does not support the format of the file found here: "
msgstr "Bookworm មិនគាំទ្រទម្រង់ឯកសារដែលរកឃើញនៅទីនេះទេ៖ "

#: src/constants.vala.in:51
msgid ""
"Requested content could not be fetched. Please remove and add the eBook file "
"found here: "
msgstr ""
"មិនអាចទាញយកមាតិកាដែលបានស្នើសុំបានទេ។ សូមលុប រួចបន្ថែមឯកសារសៀវភៅអេឡិចត្រូនិចនៅទីនេះឡើងវិញ៖ "

#: src/constants.vala.in:52
msgid "Issue in page navigation, please move the pages forward or backward."
msgstr "មានបញ្ហាក្នុងការផ្លាស់ប្តូរទំព័រ សូមព្យាយាមទំព័រទៅមុខ ឬថយក្រោយ។"

#: src/constants.vala.in:53
msgid "Library"
msgstr "បណ្ណាល័យ"

#: src/constants.vala.in:54
msgid "Resume"
msgstr "បន្ត"

#: src/constants.vala.in:55
msgid "Contents"
msgstr "មាតិកា"

#: src/constants.vala.in:56
msgid "Content #"
msgstr "មាតិកា #"

#: src/constants.vala.in:57
msgid "Bookmarks"
msgstr "ចំណាំ"

#: src/constants.vala.in:58
msgid "Bookmark #NNN for Section PPP"
msgstr "ចំណាំ #NNN សម្រាប់ផ្នែក PPP"

#: src/constants.vala.in:59
msgid "Click on a link to jump to bookmarked section"
msgstr "ចុចលើតំណដើម្បីលោតទៅផ្នែកដែលបានចំណាំ"

#: src/constants.vala.in:60
msgid ""
"No bookmarks set in BBB, click the bookmark icon on the header bar to "
"bookmark the page"
msgstr ""
"មិនទាន់មានចំណាំក្នុង BBB ទេ សូមចុចរូបសញ្ញាចំណាំនៅរបារក្បាល ដើម្បីចំណាំទំព័រនេះ"

#: src/constants.vala.in:61
msgid "Word Meaning"
msgstr "អត្ថន័យពាក្យ"

#: src/constants.vala.in:62
msgid "Search Results"
msgstr "លទ្ធផលស្វែងរក"

#: src/constants.vala.in:63
msgid "Annotations"
msgstr "ចំណារពន្យល់"

#: src/constants.vala.in:64
msgid "Annotation Tags"
msgstr "ស្លាកចំណារពន្យល់"

#: src/constants.vala.in:65
msgid "Comma-separated tags for this annotation"
msgstr "ស្លាកបំបែកដោយសញ្ញាក្បៀសសម្រាប់ចំណារពន្យល់នេះ"

#: src/constants.vala.in:66
msgid "Edit annotation for:"
msgstr "កែសម្រួលចំណារពន្យល់សម្រាប់:"

#: src/constants.vala.in:67
msgid "Click on a link to jump to an annotated section"
msgstr "ចុចលើតំណដើម្បីលោតទៅផ្នែកដែលមានចំណារពន្យល់"

#: src/constants.vala.in:68
msgid ""
"No annotations set in BBB, right click the page of a book and choose "
"annotation from the context menu to add annotations"
msgstr ""
"មិនទាន់មានចំណារពន្យល់ក្នុង BBB ទេ សូមចុចស្តាំលើទំព័រនៃសៀវភៅ រួចជ្រើសរើសចំណារពន្យល់ពីម៉ឺនុយបរិបទ ដើម្បី"
"បន្ថែមចំណារពន្យល់"

#: src/constants.vala.in:69
msgid "Searching for '$$$' in &&&:"
msgstr "កំពុងស្វែងរក '$$$' នៅក្នុង &&&:"

#: src/constants.vala.in:70
msgid "Found the following matches for '$$$' in &&&:"
msgstr "រកឃើញការផ្គូផ្គងដូចខាងក្រោមសម្រាប់ '$$$' នៅក្នុង &&&:"

#: src/constants.vala.in:71
msgid "No matches found for '$$$' in &&&"
msgstr "រកមិនឃើញការផ្គូផ្គងសម្រាប់ '$$$' នៅក្នុង &&& ទេ"

#: src/constants.vala.in:72
msgid "Select a word in the book and right click for looking up its meaning"
msgstr "ជ្រើសរើសពាក្យក្នុងសៀវភៅ រួចចុចស្តាំដើម្បីស្វែងរកអត្ថន័យរបស់វា"

#: src/constants.vala.in:73
msgid "Edit Info for"
msgstr "កែសម្រួលព័ត៌មានសម្រាប់"

#: src/constants.vala.in:74 src/constants.vala.in:78
msgid "Update Cover Image"
msgstr "ធ្វើបច្ចុប្បន្នភាពរូបភាពគម្រប"

#: src/constants.vala.in:75
msgid "Update Title"
msgstr "ធ្វើបច្ចុប្បន្នភាពចំណងជើង"

#: src/constants.vala.in:76
msgid "Update Tags"
msgstr "ធ្វើបច្ចុប្បន្នភាពស្លាក"

#: src/constants.vala.in:77
msgid "Update Author"
msgstr "ធ្វើបច្ចុប្បន្នភាពអ្នកនិពន្ធ"

#: src/constants.vala.in:79
msgid "Enter fullscreen view (F11)"
msgstr "ចូលទិដ្ឋភាពពេញអេក្រង់ (F11)"

#: src/constants.vala.in:80
msgid "Exit fullscreen view (Esc)"
msgstr "ចេញពីទិដ្ឋភាពពេញអេក្រង់ (Esc)"

#: src/constants.vala.in:81
msgid "Check Word Meaning"
msgstr "ពិនិត្យអត្ថន័យពាក្យ"

#: src/constants.vala.in:82
msgid "Annotate selected text"
msgstr "ធ្វើចំណារពន្យល់លើអត្ថបទដែលបានជ្រើសរើស"

#: src/constants.vala.in:83
msgid "Books"
msgstr "សៀវភៅ"

#: src/constants.vala.in:84
msgid "Images"
msgstr "រូបភាព"

#: src/constants.vala.in:85
msgid "All Files"
msgstr "ឯកសារទាំងអស់"

#: src/constants.vala.in:86
msgid "Title"
msgstr "ចំណងជើង"

#: src/constants.vala.in:87
msgid "Author"
msgstr "អ្នកនិពន្ធ"

#: src/constants.vala.in:88
msgid "Last Opened"
msgstr "បើកចុងក្រោយ"

#: src/constants.vala.in:89
msgid "Rating"
msgstr "ការវាយតម្លៃ"

#: src/constants.vala.in:90
msgid "Tags"
msgstr "ស្លាក"

#: src/constants.vala.in:91
msgid "Today"
msgstr "ថ្ងៃនេះ"

#: src/constants.vala.in:92
msgid "Yesterday"
msgstr "ម្សិលមិញ"

#: src/constants.vala.in:93
msgid "Days"
msgstr "ថ្ងៃ"

#: src/constants.vala.in:94
msgid "Discovery of books will be started when Bookworm is closed"
msgstr "ការស្វែងរកសៀវភៅនឹងចាប់ផ្តើមនៅពេល Bookworm ត្រូវបានបិទ"

#: src/constants.vala.in:96
msgid "Add books to library"
msgstr "បន្ថែមសៀវភៅទៅបណ្ណាល័យ"

#: src/constants.vala.in:97
msgid "Remove selected books from library (eBook file will not be deleted)"
msgstr ""
"លុបសៀវភៅដែលបានជ្រើសរើសចេញពីបណ្ណាល័យ (ឯកសារសៀវភៅអេឡិចត្រូនិចនឹងមិនត្រូវបានលុបទេ)"

#: src/constants.vala.in:98
msgid "Select books to enable removal"
msgstr "ជ្រើសរើសសៀវភៅដើម្បីអាចលុបបាន"

#: src/constants.vala.in:99
msgid "Select one or more books in library"
msgstr "ជ្រើសរើសសៀវភៅមួយ ឬច្រើនក្នុងបណ្ណាល័យ"

#: src/constants.vala.in:100
msgid "See Table of Contents, Bookmarks and Search Results"
msgstr "មើលតារាងមាតិកា ចំណាំ និងលទ្ធផលស្វែងរក"

#: src/constants.vala.in:101
msgid "Reading preferences"
msgstr "ចំណូលចិត្តការអាន"

#: src/constants.vala.in:102
msgid "Click to bookmark this page"
msgstr "ចុចដើម្បីចំណាំទំព័រនេះ"

#: src/constants.vala.in:103
msgid "Click to remove this bookmark"
msgstr "ចុចដើម្បីលុបចំណាំនេះ"

#: src/constants.vala.in:104
msgid "Increase font size (Ctrl + Shift + '+')"
msgstr "បង្កើនទំហំអក្សរ (Ctrl + Shift + '+')"

#: src/constants.vala.in:105
msgid "Decrease font size (Ctrl + '-')"
msgstr "បន្ថយទំហំអក្សរ (Ctrl + '-')"

#: src/constants.vala.in:106
msgid "Increase line width"
msgstr "បង្កើនទទឹងបន្ទាត់"

#: src/constants.vala.in:107
msgid "Decrease line width"
msgstr "បន្ថយទទឹងបន្ទាត់"

#: src/constants.vala.in:108
msgid "Increase line spacing"
msgstr "បង្កើនគម្លាតបន្ទាត់"

#: src/constants.vala.in:109
msgid "Decrease line spacing"
msgstr "បន្ថយគម្លាតបន្ទាត់"

#: src/constants.vala.in:110
msgid "Align left"
msgstr "តម្រឹមឆ្វេង"

#: src/constants.vala.in:111
msgid "Align right"
msgstr "តម្រឹមស្តាំ"

#: src/constants.vala.in:112
msgid "Update cover image"
msgstr "ធ្វើបច្ចុប្បន្នភាពរូបភាពគម្រប"

#: src/constants.vala.in:113
msgid "Apply theme for this colour profile"
msgstr "អនុវត្តប្រធានបទសម្រាប់ទម្រង់ពណ៌នេះ"

#: src/constants.vala.in:114 src/constants.vala.in:115
msgid "Enter fullscreen view and Esc key to undo"
msgstr "ចូលទិដ្ឋភាពពេញអេក្រង់ ហើយចុច Esc ដើម្បីមិនធ្វើវិញ"

#: src/constants.vala.in:116
msgid "Add folder to scan for books"
msgstr "បន្ថែមថតដើម្បីស្កេនរកសៀវភៅ"

#: src/constants.vala.in:117
msgid "Remove displayed folder from book scan"
msgstr "លុបថតដែលបង្ហាញចេញពីការស្កេនសៀវភៅ"

#: src/constants.vala.in:118
msgid "Add annotation to selected text"
msgstr "បន្ថែមចំណារពន្យល់ទៅអត្ថបទដែលបានជ្រើសរើស"

#: src/constants.vala.in:119
msgid "Go to previous page"
msgstr "ទៅទំព័រមុន"

#: src/constants.vala.in:120
msgid "Go to next page"
msgstr "ទៅទំព័របន្ទាប់"

#: src/constants.vala.in:122 src/constants.vala.in:151
msgid "Preferences"
msgstr "ចំណូលចិត្ត"

#: src/constants.vala.in:123
msgid "Turn on Dark Mode"
msgstr "បើករបៀបងងឹត"

#: src/constants.vala.in:124
