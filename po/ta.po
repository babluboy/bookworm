#: src/bookworm.vala:109
msgid "Display version number"
msgstr "பதிப்பு எண்ணைக் காண்பி"

#: src/bookworm.vala:110
msgid "Run Bookworm in debug mode"
msgstr "பிழைஅறி முறையில் புத்தகப்புழுவை இயக்கவும்"

#: src/bookworm.vala:111
msgid "Run Bookworm in info mode"
msgstr "தகவல் முறையில் புத்தகப்புழுவை இயக்கவும்"

#: src/bookworm.vala:112
msgid "Automatically add new books from watched folders"
msgstr "கோப்புறைகளில் கண்ட புதிய புத்தகங்களை தானாகவே சேர்க்கவும்"

#: src/utils.vala:552 src/utils.vala:639
msgid "Cancel"
msgstr "நீக்கு"

#: src/utils.vala:554 src/utils.vala:640
msgid "Open"
msgstr "திற"

#: src/utils.vala:556
msgid "Save"
msgstr "சேமி"

#: src/constants.vala.in:29
msgid "An eBook Reader"
msgstr "ஒரு மின்னூல் வாசகர்"

#: src/constants.vala.in:31
msgid "Weblate Translators"
msgstr "வெப்லேட் மொழிபெயர்ப்பாளர்கள்"

#: src/constants.vala.in:37
msgid "Website | Translation | Bug Tracker"
msgstr "வலைத்தளம் | மொழிபெயர்ப்பு | பிழை பின்தொடர்பாளர்"

#: src/constants.vala.in:39
msgid "Not Available"
msgstr "இருப்பு இல்லை"

#: src/constants.vala.in:40 data/com.github.babluboy.bookworm.desktop.in:4
msgid "eBook Reader"
msgstr "மின்னூல் வாசகர்"

#: src/constants.vala.in:41
msgid "Search this book…"
msgstr "இந்த நூலைத் தேடுங்கள்…"

#: src/constants.vala.in:42
msgid "Search by Title, Author and Tags"
msgstr "தலைப்பு, ஆசிரியர் மற்றும் குறிச்சொற்கள் மூலம் தேடுங்கள்"

#: src/constants.vala.in:43
msgid "Looks like Bookworm has no books"
msgstr "புத்தகப்புழுவில் நூல்கள் இல்லை போல் தெரிகிறது"

#: src/constants.vala.in:44
msgid "Build your library by adding eBooks"
msgstr "மின்னூல்கள் சேர்த்து உங்கள் நூலகத்தை கட்டியமையுங்கள்"

#: src/constants.vala.in:45
msgid "Select an eBook to read"
msgstr "வாசிக்க ஒரு மின்னூலை தேர்ந்தெடு"

#: src/constants.vala.in:46
msgid ""
"Problem in extracting contents of book. Ensure there is a valid eBook file "
"here: "
msgstr ""
"புத்தகத்தின் உள்ளடக்கங்களைப் பிரித்தெடுப்பதில் சிக்கல். இங்கு சரியான மின்னூல் கோப்பு இருப்பை "
"உறுதிசெய்: "

#: src/constants.vala.in:47
msgid "Invalid media type detected. Check format for this eBook: "
msgstr ""
"தவறான ஊடக வகை கண்டறியப்பட்டது. இந்த மின் நூலுக்கான வடிவமைப்பை சரிபார்க்கவும்: "

#: src/constants.vala.in:48
msgid "Invalid content found. Ensure there is a valid eBook file here: "
msgstr ""
"தவறான உள்ளடக்கம் காணப்பட்டது. இங்கு சரியான மின்னூல் கோப்பு இருப்பை உறுதிசெய்: "

#: src/constants.vala.in:49
msgid "eBook could not be parsed. Ensure there is a valid eBook file here: "
msgstr ""
"மின்னூலை பகுத்தறிய இயலவில்லை. இங்கு சரியான மின்னூல் கோப்பு இருப்பை உறுதிசெய்: "

#: src/constants.vala.in:50
msgid "Bookworm does not support the format of the file found here: "
msgstr "இங்கே கண்ட கோப்பின் வடிவமைப்பை புத்தகப்புழு ஆதரிக்காது: "

#: src/constants.vala.in:51
msgid ""
"Requested content could not be fetched. Please remove and add the eBook file "
"found here: "
msgstr ""
"கோரப்பட்ட உள்ளடக்கம் கொண்டுவர இயலவில்லை. தயவுசெய்து இங்கே கண்ட மின்னூல் கோப்பை அகற்றி பின் "
"சேர்க்கவும்: "

#: src/constants.vala.in:52
msgid "Issue in page navigation, please move the pages forward or backward."
msgstr ""
"பக்கங்கள் மாறுவதில் சிக்கல், தயவுசெய்து பக்கங்களை முன்னும் பின்னும் நகர்த்தவும்."

#: src/constants.vala.in:53
msgid "Library"
msgstr "நூலகம்"

#: src/constants.vala.in:54
msgid "Resume"
msgstr "மறு தொடக்கம்"

#: src/constants.vala.in:55
msgid "Contents"
msgstr "உள்ளடக்கம்"

#: src/constants.vala.in:56
msgid "Content #"
msgstr "உள்ளடக்கம் #"

#: src/constants.vala.in:57
msgid "Bookmarks"
msgstr "புத்தககுறியீடு"

#: src/constants.vala.in:58
msgid "Bookmark #NNN for Section PPP"
msgstr "PPP பிரிவுக்கு # NNN புத்தககுறி இடு"

#: src/constants.vala.in:59
msgid "Click on a link to jump to bookmarked section"
msgstr "புத்தககுறி இடப்பட்ட பிரிவுக்கு தாவிச் செல்ல ஒரு இணைப்பின் மேல் சொடுக்கு"

#: src/constants.vala.in:60
msgid ""
"No bookmarks set in BBB, click the bookmark icon on the header bar to "
"bookmark the page"
msgstr ""
"BBB யில் புத்தககுறி இடப்படவில்லை, பக்கத்தை புத்தககுறியிட தலைப்பு பட்டியில் உள்ள "
"புத்தககுறி படவுரு மீது சொடுக்கு"

#: src/constants.vala.in:61
msgid "Word Meaning"
msgstr "சொல்லின் பொருள்"

#: src/constants.vala.in:62
msgid "Search Results"
msgstr "தேடல் முடிவுகள்"

#: src/constants.vala.in:63
msgid "Annotations"
msgstr "சிறுகுறிப்புகள்"

#: src/constants.vala.in:64
msgid "Annotation Tags"
msgstr "சிறுகுறிப்பு குறிச்சொற்கள்"

#: src/constants.vala.in:65
msgid "Comma-separated tags for this annotation"
msgstr "இந்த சிறுகுறிப்புக்கான குறிச்சொற்கள் காற்புள்ளியால் பிரிக்கப்பட்டுள்ளது"

#: src/constants.vala.in:66
msgid "Edit annotation for:"
msgstr "சிறுகுறிப்பைத் திருத்து:"

#: src/constants.vala.in:67
msgid "Click on a link to jump to an annotated section"
msgstr "சிறுகுறிப்பிடப்பட்ட பிரிவுக்கு தாவிச்செல்ல ஒரு இணைப்பின் மீது சொடுக்கு"

#: src/constants.vala.in:68
msgid ""
"No annotations set in BBB, right click the page of a book and choose "
"annotation from the context menu to add annotations"
msgstr ""
"BBB யில் சிறுகுறிப்புகள் அமைக்கப்படவில்லை, சிறு குறிப்புகளைச் சேர்க்க , ஒரு புத்தகத்தின் "
"பக்கத்தை வலது சொடுக்கி,சூழல் பட்டியலிருந்து சிறுகுறிப்பைத் தேர்வுசெய்யவும்"

#: src/constants.vala.in:69
msgid "Searching for '$$$' in &&&:"
msgstr "&&& இல் '$$$' தேடுகிறது:"

#: src/constants.vala.in:70
msgid "Found the following matches for '$$$' in &&&:"
msgstr "&&& இல் '$$$' க்கு பின்வரும் இணைகள் கண்டறியப்பட்டது:"

#: src/constants.vala.in:71
msgid "No matches found for '$$$' in &&&"
msgstr "&&& இல் '$$$' க்கு இணைகள் எதுவும் காணப்படவில்லை"

#: src/constants.vala.in:72
msgid "Select a word in the book and right click for looking up its meaning"
msgstr ""
"புத்தகத்தில் ஒரு சொல்லைத் தேர்ந்தெடுத்து, அதன் பொருளைப் அறிய வலது சொடுக்கவும்"

#: src/constants.vala.in:73
msgid "Edit Info for"
msgstr "தகவலைத் திருத்தவும்"

#: src/constants.vala.in:74 src/constants.vala.in:78
msgid "Update Cover Image"
msgstr "அட்டையின் படத்தைப் மேம்படுத்தவும்"

#: src/constants.vala.in:75
msgid "Update Title"
msgstr "தலைப்பை மேம்படுத்தவும்"

#: src/constants.vala.in:76
msgid "Update Tags"
msgstr "குறிச்சொற்களை மேம்படுத்தவும்"

#: src/constants.vala.in:77
msgid "Update Author"
msgstr "ஆசிரியரை மேம்படுத்தவும்"

#: src/constants.vala.in:79
msgid "Enter fullscreen view (F11)"
msgstr "முழுத்திரை காட்சியில் உள்புக (F11)"

#: src/constants.vala.in:80
msgid "Exit fullscreen view (Esc)"
msgstr "முழுத்திரை காட்சியிலிருந்து  வெளியேற (Esc)"

#: src/constants.vala.in:81
msgid "Check Word Meaning"
msgstr "சொல்லின் பொருளை சரிபார்க்கவும்"

#: src/constants.vala.in:82
msgid "Annotate selected text"
msgstr "தேர்வு செய்யப்பட்ட உரைமீது சிறுகுறிப்பு வரை"

#: src/constants.vala.in:83
msgid "Books"
msgstr "புத்தகங்கள்"

#: src/constants.vala.in:84
msgid "Images"
msgstr "உருவங்கள்"

#: src/constants.vala.in:85
msgid "All Files"
msgstr "அனைத்து கோப்புகள்"

#: src/constants.vala.in:86
msgid "Title"
msgstr "தலைப்பு"

#: src/constants.vala.in:87
msgid "Author"
msgstr "நூலாசிரியர்"

#: src/constants.vala.in:88
msgid "Last Opened"
msgstr "கடைசியாக திறக்கப்பட்டது"

#: src/constants.vala.in:89
msgid "Rating"
msgstr "மதிப்பீடு"

#: src/constants.vala.in:90
msgid "Tags"
msgstr "குறிச்சொற்கள்"

#: src/constants.vala.in:91
msgid "Today"
msgstr "இன்று"

#: src/constants.vala.in:92
msgid "Yesterday"
msgstr "நேற்று"

#: src/constants.vala.in:93
msgid "Days"
msgstr "நாட்கள்"

#: src/constants.vala.in:94
msgid "Discovery of books will be started when Bookworm is closed"
msgstr "புத்தகப்புழு மூடியபொழுது புத்தகங்கள் கண்டுபிடிப்பு தொடங்கப்படும்"

#: src/constants.vala.in:96
msgid "Add books to library"
msgstr "நூலகத்திற்கு புத்தகங்களைச் சேர்க்கவும்"

#: src/constants.vala.in:97
msgid "Remove selected books from library (eBook file will not be deleted)"
msgstr ""
"’தேர்வு செய்த புத்தகங்களை நூலகத்திலிருந்து அகற்று (மின்னூல் கோப்பு அகற்றப்படாது)"

#: src/constants.vala.in:98
msgid "Select books to enable removal"
msgstr "அகற்றுதல் செயல்படுத்த புத்தகங்களைத் தேர்வுசெய்"

#: src/constants.vala.in:99
msgid "Select one or more books in library"
msgstr "நூலகத்தில் ஒன்று அல்லது பல புத்தகங்களைத் தேர்ந்தெடுக்கவும்"

#: src/constants.vala.in:100
msgid "See Table of Contents, Bookmarks and Search Results"
msgstr ""
"உள்ளடக்கங்கள், புத்தககுறிகள் மற்றும் தேடல் முடிவகளின் அட்டவணையை பார்க்கவும்"

#: src/constants.vala.in:101
msgid "Reading preferences"
msgstr "முன்னரிமைகளைப் படித்தல்"

#: src/constants.vala.in:102
msgid "Click to bookmark this page"
msgstr "இந்த பக்கத்தை புத்தககுறியிட சொடுக்கு"

#: src/constants.vala.in:103
msgid "Click to remove this bookmark"
msgstr "இந்த புத்தகக்குறியை அகற்ற சொடுக்கு"

#: src/constants.vala.in:104
msgid "Increase font size (Ctrl + Shift + '+')"
msgstr "எழுத்துரு அளவை அதிகரிக்க (Ctrl +Shift + ' +')"

#: src/constants.vala.in:105
msgid "Decrease font size (Ctrl + '-')"
msgstr "எழுத்துரு அளவைக் குறைக்க (Ctrl + '-')"

#: src/constants.vala.in:106
msgid "Increase line width"
msgstr "வரியின் அகலத்தை கூட்டு"

#: src/constants.vala.in:107
msgid "Decrease line width"
msgstr "வரியின் அகலத்தைக் குறை"

#: src/constants.vala.in:108
msgid "Increase line spacing"
msgstr "வரியின் இடைவெளியைக் கூட்டு"

#: src/constants.vala.in:109
msgid "Decrease line spacing"
msgstr "வரியின் இடைவெளியைக் குறை"

#: src/constants.vala.in:110
msgid "Align left"
msgstr "இடதுபுறமிருந்து சீரமைக்கவும்"

#: src/constants.vala.in:111
msgid "Align right"
msgstr "வலதுபுறமிருந்து சீரமைக்கவும்"

#: src/constants.vala.in:112
msgid "Update cover image"
msgstr "அட்டைப் படத்தைப் மேம்படுத்தவும்"

#: src/constants.vala.in:113
msgid "Apply theme for this colour profile"
msgstr "இந்த வண்ண சுயவிவரத்திற்கு உட்தோற்றம்  செயல்படுத்தவும்"

#: src/constants.vala.in:114 src/constants.vala.in:115
msgid "Enter fullscreen view and Esc key to undo"
msgstr "முழுத்திரை காட்சிக்கு Enter மற்றும் வெளியேற Esc விசையை உள்ளிடவும்"

#: src/constants.vala.in:116
msgid "Add folder to scan for books"
msgstr "புத்தகங்கள் தேடுவதற்கு கோப்புறையைச் சேர்க்கவும்"

#: src/constants.vala.in:117
msgid "Remove displayed folder from book scan"
msgstr "புத்தகத் தேடலில் காட்சிப்படுத்தப்பட்ட கோப்புறையை அகற்றவும்"

#: src/constants.vala.in:118
msgid "Add annotation to selected text"
msgstr "தேர்ந்தெடுக்கப்பட்ட உரையில் சிறுகுறிப்பைச் சேர்க்கவும்"

#: src/constants.vala.in:119
msgid "Go to previous page"
msgstr "முந்தைய பக்கத்திற்குச் செல்"

#: src/constants.vala.in:120
msgid "Go to next page"
msgstr "அடுத்த பக்கத்திற்குச் செல்"

#: src/constants.vala.in:122 src/constants.vala.in:151
msgid "Preferences"
msgstr "முன்னுரிமைகள்"

#: src/constants.vala.in:123
msgid "Turn on Dark Mode"
msgstr "கருப்பு பின்புலம் இயக்கவும்"

#: src/constants.vala.in:124
msgid "Enable cache (opens books faster)"
msgstr "குறுசேமிப்பை இயக்கவும் (புத்தகங்களை வேகமாக திறக்கிறது)"

#: src/constants.vala.in:125
msgid "Always show library on startup"
msgstr "தொடங்கும்போது நூலகத்தை எப்போதும் காட்டுங்கள்"

#: src/constants.vala.in:126
msgid "Enable two page reading"
msgstr "இரண்டு பக்க வாசிப்பை செயலாக்கவும்"

#: src/constants.vala.in:127
msgid "Select Font"
msgstr "எழுத்துருவைத் தேர்ந்தெடு"

#: src/constants.vala.in:128
msgid "Customize reading profile"
msgstr "வாசிப்பு சுயவிவரத்தைத் தனிப்பயனாக்குங்கள்"

